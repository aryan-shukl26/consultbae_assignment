# --- Task 2 support: read/write endpoints for the Make.com auto-tagging automation ---

@app.route("/api/untagged-people")
def api_untagged_people():
    conn = get_db_connection()
    rows = conn.execute("""
        SELECT p.person_id, p.canonical_name,
               GROUP_CONCAT(DISTINCT s.skill) as skills
        FROM person p
        LEFT JOIN skill s ON p.person_id = s.person_id
        WHERE p.skill_category IS NULL
        GROUP BY p.person_id
        HAVING skills IS NOT NULL
    """).fetchall()
    conn.close()

    result = [
        {"person_id": r["person_id"], "name": r["canonical_name"], "skills": r["skills"]}
        for r in rows
    ]
    return jsonify(result)


@app.route("/api/tag-person", methods=["POST"])
def api_tag_person():
    data = request.get_json()
    person_id = data.get("person_id")
    category = data.get("category")

    if not person_id or not category:
        return jsonify({"success": False, "message": "person_id and category required"}), 400

    conn = get_db_connection()
    conn.execute("UPDATE person SET skill_category = ? WHERE person_id = ?", (category, person_id))
    conn.commit()
    conn.close()

    return jsonify({"success": True, "person_id": person_id, "category": category})


